<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Shared base for every Simple Sigh text sign. Inherits the vanilla furniture base so signs can be minified and reinstalled. -->
  <ThingDef Name="SimpleSigh_SignBase" ParentName="FurnitureBase" Abstract="True">
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.2</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <statBases>
      <Flammability>1.0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <ThingDef ParentName="SimpleSigh_SignBase">
    <defName>SimpleSigh_BasicSign</defName>
    <label>sign</label>
    <description>A small standing sign with a blank panel. Select it and use "Edit text" to write a short message on the panel.</description>
    <graphicData>
      <texPath>Things/Building/SimpleSign</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0.05,0.3,0.9,0.62)</rect>
      </damageData>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <costStuffCount>30</costStuffCount>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>4</Mass>
    </statBases>
    <uiOrder>2950</uiOrder>
  </ThingDef>

</Defs>
