<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <ThingDef ParentName="FurnitureBase">
    <defName>SimpleSigh_NoticeBoard</defName>
    <label>notice board</label>
    <description>A larger sign for longer text.</description>
    <graphicData>
      <texPath>Things/Building/SimpleNoticeBoard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <size>(2,1)</size>
    <stuffCategories><li>Woody</li><li>Stony</li><li>Metallic</li></stuffCategories>
    <costStuffCount>60</costStuffCount>
    <rotatable>true</rotatable>
    <passability>Standable</passability>
    <castEdgeShadows>false</castEdgeShadows>
    <drawGUIOverlay>true</drawGUIOverlay>
    <statBases><MaxHitPoints>80</MaxHitPoints><WorkToBuild>1000</WorkToBuild><Mass>4</Mass><Beauty>1</Beauty></statBases>
    
    <comps>
      <li Class="SimpleSigh.Signs.CompProperties_SignText">
        <maxElements>256</maxElements>
        <multiline>true</multiline>
      </li>
    </comps>
  </ThingDef>
</Defs>
