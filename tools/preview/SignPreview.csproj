<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline layout preview: runs the mod's own layout code (linked sources) with real font metrics. Not the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Source/Layout/*.cs" Link="Linked/Layout/%(Filename)%(Extension)" />
    <Compile Include="../../Source/Text/*.cs" Link="Linked/Text/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
